# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

*.py    text eol=lf diff=python
*.ipynb text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cff   text eol=lf
*.json  text eol=lf
Makefile text eol=lf

# Binary assets — never convert.
*.nc    binary
*.npz   binary
*.npy   binary
*.pt    binary
*.pth   binary
*.png   binary
*.jpg   binary
*.pdf   binary

# Keep generated notebooks out of language statistics and collapse them in diffs.
*.ipynb linguist-documentation
